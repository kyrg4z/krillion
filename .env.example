# Storage. Leave both blank for local development: the app then keeps a SQLite
# file at data/krillion.db. A deployed build needs a hosted libSQL database,
# because serverless hosts give each request a read-only filesystem.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The game never calls an AI provider. These only affect document import.
AI_ENABLED=false
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
